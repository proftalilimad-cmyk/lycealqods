# Supabase — لا تضع service_role key في هذه الملفات أو في Vite
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# مفتاح إرسال عام (إرسال فقط، بلا قراءة). يجب ربطه بUUID الأستاذ في teacher_public_keys.
VITE_PUBLIC_SITE_KEY=REPLACE_WITH_RANDOM_32_CHARACTER_KEY
# بريد حساب الأستاذ الذي ينفذ عليه Supabase Auth
VITE_SUPABASE_TEACHER_EMAIL=teacher@example.com

# أسماء بديلة تقبلها نسخة البناء إذا أنشأها تكامل Supabase في Netlify
# أو استُعملت إرشادات Next.js مع هذا المشروع React/Vite.
# لا تضع SUPABASE_SERVICE_ROLE_KEY هنا أو في أي ملف يصل إلى المتصفح.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# SUPABASE_PUBLIC_SITE_KEY=REPLACE_WITH_RANDOM_32_CHARACTER_KEY
# SUPABASE_TEACHER_EMAIL=teacher@example.com
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# NEXT_PUBLIC_SITE_KEY=REPLACE_WITH_RANDOM_32_CHARACTER_KEY

# اختياري عند إعادة البناء على نطاق مختلف
SITE_URL=https://courstalil.netlify.app
