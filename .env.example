# Supabase — لا تضع service_role key في هذه الملفات أو في Vite
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# بريد حساب الأستاذ الذي ينفذ عليه Supabase Auth
VITE_SUPABASE_TEACHER_EMAIL=teacher@example.com

# اختياري عند إعادة البناء على نطاق مختلف
SITE_URL=https://courstalil.netlify.app
